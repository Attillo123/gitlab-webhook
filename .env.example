# GitLab signing token (whsec_...), copied from the GitLab webhook settings.
GITLAB_SIGNING_TOKEN=
# Keep the existing token during migration; remove it after signed deliveries are confirmed.
GITLAB_SECRET_TOKEN=replace-with-gitlab-secret
GITLAB_WEBHOOK_TOLERANCE_SECONDS=300
GITLAB_WEBHOOK_IMAGE=gitlab-webhook:latest
FEISHU_SECRET=
FEISHU_TIMEOUT=10
FEISHU_RETRY_COUNT=3
FEISHU_RETRY_BACKOFF=1
MAX_MESSAGE_LENGTH=12000
DEDUPE_TTL_SECONDS=86400
LOG_LEVEL=INFO
